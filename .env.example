# 复制这个文件为 .env（本地开发用），并填入真实值。
# 部署到 Netlify 时，同样这几个变量要填到 Netlify 后台的 Site settings → Environment variables 里，
# 本地 .env 文件不会被上传部署。

# Supabase 项目设置 → API 里能找到
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PayPal 开发者后台（developer.paypal.com）→ My Apps & Credentials 里创建一个 App 拿到
# 先用 Sandbox 的 Client ID 测试，确认没问题后再换成 Live 的 Client ID
VITE_PAYPAL_CLIENT_ID=

# Formspree（formspree.io）新建一个表单后，表单地址 https://formspree.io/f/xxxxxxx 里 xxxxxxx 这段
VITE_FORMSPREE_FORM_ID=
